{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AlexSol/mkdocs-flow-player/main/src/mkdocs_flow_player/schema/scenario.schema.json",
  "title": "MkDocs Flow Player scenario",
  "description": "A step-by-step scenario played over a Mermaid topology. Node IDs and edge from/to values must resolve against the referenced .mmd file; that check happens during `mkdocs build`, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Unique scenario identifier. Must be unique across the whole site."
    },
    "title": {
      "type": "string",
      "description": "Human-readable heading shown above the player. Defaults to `id`."
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "description": "Autoplay dwell time per step, in milliseconds. Default 1500."
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered playback steps. Each step targets exactly one node or one edge.",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "state": {
      "enum": ["active", "success", "warning", "error", "waiting"],
      "description": "Visual state applied to a node. The last applicable step per node wins."
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "description": "Mermaid node ID to highlight." },
        "edge": { "$ref": "#/$defs/edge" },
        "state": { "$ref": "#/$defs/state" },
        "action": {
          "const": "travel",
          "description": "Edge steps only. Currently the sole action; also the default."
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "payload": {
          "description": "Arbitrary JSON-compatible value shown in the details panel. `false`, `0` and `null` are allowed."
        }
      },
      "oneOf": [
        { "required": ["node"], "not": { "required": ["edge"] } },
        { "required": ["edge"], "not": { "required": ["node"] } }
      ],
      "allOf": [
        {
          "if": { "required": ["node"] },
          "then": { "not": { "required": ["action"] } }
        },
        {
          "if": { "required": ["edge"] },
          "then": { "not": { "required": ["state"] } }
        }
      ]
    }
  }
}
